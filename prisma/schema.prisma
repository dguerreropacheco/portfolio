generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Proyecto {
  id          String   @id @default(uuid())
  titulo      String
  descripcion String
  imagenUrl   String
  repoUrl     String?
  demoUrl     String?
  createdAt   DateTime @default(now())
  skills      Skill[]  @relation("ProyectoToSkill")
}

model Skill {
  id        String     @id @default(uuid())
  nombre    String
  iconoUrl  String?
  categoria String
  proyectos Proyecto[] @relation("ProyectoToSkill")
}
